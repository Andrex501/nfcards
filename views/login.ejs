<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>Acceso Administrativo | NFC & QR Manager</title>
  <meta name="description" content="Portal de autenticación seguro para el panel de administración de tarjetas NFC y códigos QR.">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22%20%220%22%20%22100%22%20%22100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">
</head>
<body>
  <div class="mobile-viewport">
    <main class="mobile-card-container" style="max-width: 400px;">
      
      <!-- Encabezado de Autenticación -->
      <header class="profile-header" style="margin-bottom: 1.75rem;">
        <div class="avatar-wrapper" style="width: 72px; height: 72px; margin-bottom: 1rem;">
          <div class="business-avatar" style="font-size: 1.75rem;">
            ⚡
          </div>
          <div class="nfc-badge" style="background: var(--btn-primary-bg); border-color: var(--btn-primary-border); color: #93c5fd;" title="Seguridad del Sistema">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
        </div>

        <h1 class="business-title" style="font-size: 1.35rem; margin-bottom: 0.25rem;">Panel de Control</h1>
        <p style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.45;">
          Ingresa la contraseña maestra para administrar tarjetas inteligentes NFC &amp; QR.
        </p>
      </header>

      <!-- Alertas de Error o Notificación -->
      <% if (error) { %>
        <div class="alert alert-error" style="margin-bottom: 1.25rem; font-size: 0.85rem; padding: 0.75rem 1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (message) { %>
        <div class="alert alert-success" style="margin-bottom: 1.25rem; font-size: 0.85rem; padding: 0.75rem 1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span><%= message %></span>
        </div>
      <% } %>

      <!-- Formulario de Login -->
      <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: 1.15rem;">
        
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="password">Contraseña Administrativa</label>
          <div style="position: relative;">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-input" 
              placeholder="••••••••••••" 
              required 
              autofocus
              autocomplete="current-password"
            >
          </div>
          <small class="form-hint">
            Configurada en la variable de entorno <code>ADMIN_PASSWORD</code>.
          </small>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 0.25rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
          Iniciar Sesión
        </button>

      </form>

      <!-- Pie de Seguridad -->
      <footer class="mobile-footer" style="margin-top: 1.75rem; padding-top: 1rem;">
        <div class="nfc-tag-indicator" style="font-size: 0.7rem; color: var(--text-dim);">
          <span>Protegido con Sesiones Seguras &bull; SaaS Colombia</span>
        </div>
      </footer>

    </main>
  </div>
</body>
</html>
