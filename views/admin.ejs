                    <!-- Personalización de Título y Subtítulo -->
                    <div class="form-custom-texts-box">
                      <div class="form-custom-texts-header">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2">
                          <path d="M12 20h9"></path>
                          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                        <span>Personalización del Botón</span>
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="websiteTitle">Título del Botón</label>
                        <input type="text" name="websiteTitle" id="websiteTitle" class="form-custom-input"
                          placeholder="Visita Nuestro Sitio Web"
                          value="<%= selectedCard ? (selectedCard.websiteTitle || 'Visita Nuestro Sitio Web') : 'Visita Nuestro Sitio Web' %>">
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="websiteSubtitle">Subtítulo del Botón</label>
                        <input type="text" name="websiteSubtitle" id="websiteSubtitle" class="form-custom-input"
                          placeholder="Tienda virtual y catálogo oficial"
                          value="<%= selectedCard ? (selectedCard.websiteSubtitle || 'Tienda virtual y catálogo oficial') : 'Tienda virtual y catálogo oficial' %>">
                      </div>
                    </div>
                  </div>

                  <!-- ==============================================
                       BLOQUE 8: UBICACIÓN GOOGLE MAPS
                       ============================================== -->
                  <div class="form-module-card">
                    <div class="form-module-header">
                      <div class="form-module-title-group">
                        <div class="form-module-icon icon-location">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                          </svg>
                        </div>
                        <h3 class="form-module-title">Ubicación & GPS</h3>
                      </div>
                      <span class="form-module-badge">Maps</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label" for="googleReviewsUrl">Enlace de Google Maps</label>
                      <input type="url" name="googleReviewsUrl" id="googleReviewsUrl" class="form-input"
                        placeholder="Ej: https://maps.app.goo.gl/... o enlace de Maps"
                        value="<%= selectedCard ? (selectedCard.googleReviewsUrl || '') : '' %>">
                      <small class="form-hint">Abre la app de Google Maps para navegación directa.</small>
                    </div>

                    <!-- Personalización de Título y Subtítulo -->
                    <div class="form-custom-texts-box">
                      <div class="form-custom-texts-header">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2">
                          <path d="M12 20h9"></path>
                          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                        <span>Personalización del Botón</span>
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="googleReviewsTitle">Título del Botón</label>
                        <input type="text" name="googleReviewsTitle" id="googleReviewsTitle" class="form-custom-input"
                          placeholder="Ubicación del Local"
                          value="<%= selectedCard ? (selectedCard.googleReviewsTitle || 'Ubicación del Local') : 'Ubicación del Local' %>">
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="googleReviewsSubtitle">Subtítulo del Botón</label>
                        <input type="text" name="googleReviewsSubtitle" id="googleReviewsSubtitle"
                          class="form-custom-input" placeholder="Ver en Google Maps • Cómo llegar"
                          value="<%= selectedCard ? (selectedCard.googleReviewsSubtitle || 'Ver en Google Maps • Cómo llegar') : 'Ver en Google Maps • Cómo llegar' %>">
                      </div>
