<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>NithSoft | Panel de Control Inteligente</title>
  <meta name="description"
    content="Plataforma de gestión de inventario y configuración para tarjetas físicas NFC y códigos QR permanentes NithSoft.">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22%20%220%22%20%22100%22%20%22100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">
  <style>
    /* Eliminación estricta de desbordamiento horizontal y contención total */
    html,
    body {
      overflow-x: hidden !important;
      max-width: 100% !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    }

    /* Margen y respiración equilibrada para el panel de administración */
    .admin-layout {
      box-sizing: border-box !important;
      padding-left: clamp(14px, 2.5vw, 32px) !important;
      padding-right: clamp(14px, 2.5vw, 32px) !important;
      max-width: 100% !important;
      width: 100% !important;
      margin: 0 auto !important;
      overflow-x: hidden !important;
    }

    /* Métricas superiores simétricas */
    .metrics-strip {
      display: grid !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 0.75rem !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }

    .metric-card.scans {
      background: rgba(30, 43, 60, 0.35) !important;
      border-color: rgba(59, 130, 246, 0.3) !important;
    }

    .metric-card.scans .metric-label {
      color: #93c5fd !important;
    }

    @media (max-width: 640px) {
      .metrics-strip {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }

    @media (min-width: 880px) {
      .metrics-strip {
        width: auto !important;
        min-width: 440px !important;
      }
    }

    /* Grid principal con contención y alineación perfecta de columnas */
    .admin-grid {
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 1.5rem !important;
      align-items: stretch !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
      padding-right: 0 !important;
    }

    @media (min-width: 1024px) {
      .admin-grid {
        grid-template-columns: minmax(0, 1fr) 380px !important;
        gap: 1.75rem !important;
        padding-right: 0 !important;
        align-items: stretch !important;
      }

      /* Igualación vertical fluida de ambas columnas en Desktop */
      .panel-inventory-box {
        display: flex !important;
        flex-direction: column !important;
        height: calc(100vh - 12rem) !important;
        min-height: 600px !important;
        max-height: calc(100vh - 12rem) !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
      }

      .panel-inventory-box .panel-header-row,
      .panel-inventory-box .inventory-search-row {
        flex-shrink: 0 !important;
      }

      .panel-inventory-box .cards-table-wrapper {
        flex: 1 1 0% !important;
        height: 100% !important;
        max-height: none !important;
        overflow-y: auto !important;
        overflow-x: auto !important;
        min-height: 0 !important;
      }

      .panel-form-box {
        display: flex !important;
        flex-direction: column !important;
        height: calc(100vh - 12rem) !important;
        min-height: 600px !important;
        max-height: calc(100vh - 12rem) !important;
        width: 380px !important;
        min-width: 340px !important;
        max-width: 380px !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
        position: static !important;
      }

      .panel-form-box .panel-header-row {
        flex-shrink: 0 !important;
      }

      .panel-form-box #card-form {
        flex: 1 1 0% !important;
        height: 100% !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        padding-right: 6px !important;
        min-height: 0 !important;
      }
    }

    @media (max-width: 1023px) {
      .panel-inventory-box {
        height: auto !important;
        min-height: auto !important;
        max-height: none !important;
      }

      .panel-inventory-box .cards-table-wrapper {
        height: auto !important;
        max-height: 480px !important;
      }

      .panel-form-box {
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
        min-height: auto !important;
        max-height: none !important;
        overflow: visible !important;
      }

      .panel-form-box #card-form {
        height: auto !important;
        overflow-y: visible !important;
        overflow-x: hidden !important;
        padding-right: 0 !important;
      }
    }

    /* Scrollbar personalizada para el formulario interno */
    #card-form {
      scrollbar-width: thin;
      scrollbar-color: var(--border-strong) rgba(0, 0, 0, 0.3);
    }

    #card-form::-webkit-scrollbar {
      width: 6px;
    }

    #card-form::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.25);
      border-radius: var(--radius-full);
    }

    #card-form::-webkit-scrollbar-thumb {
      background: var(--border-strong);
      border-radius: var(--radius-full);
      transition: background 0.2s ease;
    }

    #card-form::-webkit-scrollbar-thumb:hover {
      background: var(--border-focus);
    }

    /* Bloques y Tarjetas Modulares para el Panel de Configuración */
    .form-module-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-md);
      padding: 1rem 1rem 1.15rem;
      margin-bottom: 1.15rem;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    }

    .form-module-card:hover {
      border-color: var(--border-strong);
      background: rgba(255, 255, 255, 0.03);
    }

    .form-module-card:focus-within {
      border-color: rgba(147, 197, 253, 0.4);
      background: rgba(255, 255, 255, 0.035);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    }

    .form-module-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .form-module-title-group {
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }

    .form-module-icon {
      width: 26px;
      height: 26px;
      border-radius: var(--radius-xs);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 0.85rem;
    }

    .form-module-icon.icon-general {
      background: rgba(255, 255, 255, 0.08);
      color: #f3f4f6;
    }

    .form-module-icon.icon-whatsapp {
      background: #0d2a1c;
      color: #86efac;
      border: 1px solid #1a4230;
    }

    .form-module-icon.icon-instagram {
      background: #27162b;
      color: #f472b6;
      border: 1px solid #4a1d4b;
    }

    .form-module-icon.icon-facebook {
      background: #0e2038;
      color: #93c5fd;
      border: 1px solid #1e3a64;
    }

    .form-module-icon.icon-tiktok {
      background: #1c1c22;
      color: #f1f5f9;
      border: 1px solid #33333e;
    }

    .form-module-icon.icon-website {
      background: #0c272e;
      color: #5eead4;
      border: 1px solid #164e5c;
    }

    .form-module-icon.icon-location {
      background: #182234;
      color: #93c5fd;
      border: 1px solid #233857;
    }

    .form-module-icon.icon-vcard {
      background: #0f2338;
      color: #93c5fd;
      border: 1px solid #1e3a64;
    }

    .form-module-icon.icon-status {
      background: rgba(255, 255, 255, 0.06);
      color: #e2e8f0;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .form-module-title {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.01em;
      margin: 0;
    }

    .form-module-badge {
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.15rem 0.45rem;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-muted);
    }

    .form-module-badge.badge-required {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.25);
    }

    /* Sub-caja elegante para personalización de Título y Subtítulo */
    .form-custom-texts-box {
      background: rgba(0, 0, 0, 0.28);
      border: 1px dashed rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-sm);
      padding: 0.75rem 0.85rem;
      margin-top: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .form-custom-texts-header {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .form-custom-field {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .form-custom-label {
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--text-muted);
    }

    .form-custom-input {
      background: #0d0d0d !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
      border-radius: var(--radius-xs) !important;
      color: var(--text-primary) !important;
      padding: 0.45rem 0.65rem !important;
      font-size: 0.82rem !important;
      min-height: 34px !important;
      width: 100% !important;
      box-sizing: border-box !important;
      transition: all 0.15s ease !important;
    }

    .form-custom-input:focus {
      border-color: rgba(147, 197, 253, 0.5) !important;
      background: #111111 !important;
      outline: none !important;
      box-shadow: 0 0 0 2px rgba(147, 197, 253, 0.1) !important;
    }

    /* Logo controlado: circular y dimensiones fijas */
    .logo-preview-avatar {
      width: 60px !important;
      height: 60px !important;
      min-width: 60px !important;
      min-height: 60px !important;
      border-radius: 50% !important;
      overflow: hidden !important;
    }

    .logo-preview-avatar img {
      width: 60px !important;
      height: 60px !important;
      object-fit: cover !important;
      border-radius: 50% !important;
    }

    /* Alineación limpia y fija para columna Negocio Asignado */
    .cell-business {
      min-width: 240px;
    }

    .table-business-cell {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }

    .business-cell-details {
      min-width: 0;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .business-cell-name {
      font-weight: 600;
      color: var(--text-primary);
      font-size: 0.92rem;
      line-height: 1.3;
      word-break: break-word;
    }

    .business-cell-location {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.78rem;
      color: #94a3b8;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    .business-cell-location .location-pin {
      flex-shrink: 0;
      font-size: 0.82rem;
      line-height: 1;
      display: inline-block;
    }

    .business-cell-location .location-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .business-cell-date {
      font-size: 0.72rem;
      color: var(--text-muted);
      margin-top: 0.05rem;
    }
  </style>
</head>

<body>
  <div class="admin-layout">

    <!-- Encabezado Principal Señorial NithSoft -->
    <header class="admin-header">
      <div class="brand-wrapper">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;">
          <div class="brand-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>NithSoft Hardware &middot; Colombia</span>
          </div>
          <a href="/logout" class="btn-secondary btn-sm" style="font-size: 0.78rem; gap: 0.4rem;"
            title="Cerrar sesión administrativa">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Cerrar Sesión</span>
          </a>
        </div>
        <h1 class="brand-title">
          <span>⚡</span> NithSoft
        </h1>
        <p class="brand-subtitle">
          NithSoft — Conectando negocios locales con sus clientes al instante.
        </p>
      </div>

      <!-- Resumen Métrico Rápido (Total Escaneos a la izquierda) -->
      <div class="metrics-strip">
        <div class="metric-card scans">
          <div class="metric-label">Total Escaneos</div>
          <div class="metric-value" style="color: #93c5fd;">
            <%= cards.reduce((acc, c)=> acc + (c.scanCount || 0), 0) %>
          </div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Total</div>
          <div class="metric-value">
            <%= cards.length %>
          </div>
        </div>
        <div class="metric-card assigned">
          <div class="metric-label">Asignadas</div>
          <div class="metric-value">
            <%= cards.filter(c=> c.status === 'assigned').length %>
          </div>
        </div>
        <div class="metric-card available">
          <div class="metric-label">Disponibles</div>
          <div class="metric-value">
            <%= cards.filter(c=> c.status === 'available').length %>
          </div>
        </div>
      </div>
    </header>

    <!-- Notificaciones y Mensajes de Operación -->
    <% if (message) { %>
      <div class="alert alert-success">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span>
          <%= message %>
        </span>
      </div>
      <% } %>

        <% if (error) { %>
          <div class="alert alert-error">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span>
              <%= error %>
            </span>
          </div>
          <% } %>

            <!-- Grid Principal de Dos Columnas -->
            <div class="admin-grid">

              <!-- Columna Izquierda: Inventario de Tarjetas -->
              <section class="panel-box panel-inventory-box">
                <div class="panel-header-row">
                  <h2 class="panel-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                      <line x1="2" y1="10" x2="22" y2="10"></line>
                    </svg>
                    <span>Inventario de Tarjetas</span>
                  </h2>

                  <!-- Formulario rápido para registrar nuevo Card ID -->
                  <form action="/admin/create" method="POST" class="quick-add-form">
                    <input type="text" name="cardId" placeholder="Ej: 004" required class="quick-add-input"
                      title="ID numérico o alfanumérico para la tarjeta física">
                    <button type="submit" class="btn-primary btn-sm" title="Crear nueva tarjeta en blanco">
                      + Agregar
                    </button>
                  </form>
                </div>

                <% if (cards.length===0) { %>
                  <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                    <p style="font-size: 1rem; margin-bottom: 0.35rem; color: var(--text-primary); font-weight: 600;">
                      No hay tarjetas registradas
                    </p>
                    <p style="font-size: 0.85rem;">
                      Ingresa un ID en el campo superior para comenzar el inventario.
                    </p>
                  </div>
                  <% } else { %>
                    <!-- Buscador en tiempo real por ID de Tarjeta o Nombre de Negocio -->
                    <div class="inventory-search-row">
                      <div class="inventory-search-box">
                        <svg class="inventory-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="cardSearchInput" class="inventory-search-input"
                          placeholder="Buscar por ID (ej: 001) o nombre del negocio..." autocomplete="off"
                          spellcheck="false">
                        <button type="button" id="cardSearchClear" class="inventory-search-clear"
                          title="Limpiar búsqueda" aria-label="Limpiar búsqueda" style="display: none;"
                          onclick="clearCardSearch()">
                          ✕
                        </button>
                      </div>
                      <div class="inventory-search-counter">
                        <span id="searchCounterText">
                          <%= cards.length %>
                            <%= cards.length===1 ? 'tarjeta' : 'tarjetas' %>
                        </span>
                      </div>
                    </div>

                    <div class="cards-table-wrapper">
                      <table class="cards-table">
                        <thead>
                          <tr>
                            <th style="width: 58px;">QR</th>
                            <th style="width: 100px;">Card ID</th>
                            <th style="min-width: 240px;">Negocio Asignado</th>
                            <th style="width: 105px; text-align: center;">Escaneos</th>
                            <th style="width: 120px;">Estado</th>
                            <th style="text-align: right; width: 180px;">Acciones</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% cards.forEach(card=> { %>
                            <tr
                              class="card-row <%= (selectedCard && selectedCard.cardId === card.cardId) ? 'is-selected' : '' %>"
                              data-card-id="<%= card.cardId %>"
                              data-business="<%= (card.businessName || '') + ' ' + (card.location || '') %>">

                              <!-- Miniatura QR interactiva -->
                              <td class="cell-qr">
                                <div class="qr-thumbnail-box" title="Ampliar código QR de la tarjeta <%= card.cardId %>"
                                  data-card-id="<%= card.cardId %>"
                                  data-business="<%= card.businessName || 'Tarjeta Disponible' %>"
                                  data-qr="<%= card.qrDataUrl %>" data-url="<%= card.publicUrl %>"
                                  onclick="showQrModalFromElement(this)">
                                  <img src="<%= card.qrDataUrl %>" alt="QR <%= card.cardId %>" class="qr-thumb-img">
                                </div>
                              </td>

                              <!-- ID de la tarjeta física -->
                              <td class="cell-id">
                                <span class="card-id-badge">#<%= card.cardId %></span>
                              </td>

                              <!-- Nombre del Negocio y Ubicación -->
                              <td class="cell-business">
                                <% if (card.businessName) { %>
                                  <div class="table-business-cell">
                                    <% if (card.logoUrl) { const logoSrc=(card.logoUrl.startsWith('data:') ||
                                      card.logoUrl.startsWith('http://') || card.logoUrl.startsWith('https://') ||
                                      card.logoUrl.startsWith('/')) ? card.logoUrl : ('/' + card.logoUrl); %>
                                      <div class="table-business-logo" title="Logo de <%= card.businessName %>">
                                        <img src="<%= logoSrc %>" alt="Logo <%= card.businessName %>"
                                          onerror="this.parentElement.style.display='none';">
                                      </div>
                                      <% } %>
                                        <div class="business-cell-details">
                                          <div class="business-cell-name">
                                            <%= card.businessName %>
                                          </div>
                                          <% if (card.location) { %>
                                            <div class="business-cell-location" title="<%= card.location %>">
                                              <span class="location-pin">📍</span>
                                              <span class="location-text">
                                                <%= card.location %>
                                              </span>
                                            </div>
                                            <% } %>
                                              <div class="business-cell-date">
                                                Actualizado: <%= new Date(card.updatedAt).toLocaleDateString('es-CO') %>
                                              </div>
                                        </div>
                                  </div>
                                  <% } else { %>
                                    <span style="color: var(--text-dim); font-size: 0.88rem; font-style: italic;">
                                      Sin negocio asignado
                                    </span>
                                    <% } %>
                              </td>

                              <!-- Escaneos / Visitas Totales -->
                              <td class="cell-scans" style="text-align: center;">
                                <span class="scans-pill" title="Total de lecturas/escaneos registrados">
                                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                  </svg>
                                  <span>
                                    <%= card.scanCount || 0 %>
                                  </span>
                                </span>
                              </td>

                              <!-- Estado -->
                              <td class="cell-status">
                                <span class="status-pill <%= card.status %>">
                                  <%= card.status==='assigned' ? 'Asignada' : 'Disponible' %>
                                </span>
                              </td>

                              <!-- Acciones Rápidas -->
                              <td class="cell-actions" style="text-align: right;">
                                <div class="cards-table-actions"
                                  style="display: inline-flex; gap: 0.35rem; justify-content: flex-end; align-items: center;">

                                  <!-- Botón Ver/Descargar QR -->
                                  <button type="button" class="btn-secondary btn-sm" title="Ver y descargar código QR"
                                    data-card-id="<%= card.cardId %>"
                                    data-business="<%= card.businessName || 'Tarjeta Disponible' %>"
                                    data-qr="<%= card.qrDataUrl %>" data-url="<%= card.publicUrl %>"
                                    onclick="showQrModalFromElement(this)">
                                    QR
                                  </button>

                                  <!-- Botón Editar -->
                                  <a href="/admin?edit=<%= card.cardId %>" class="btn-secondary btn-sm"
                                    title="Editar datos del negocio">
                                    Editar
                                  </a>

                                  <!-- Botón Probar enlace NFC / QR público -->
                                  <a href="/p/<%= card.cardId %>" target="_blank" class="btn-secondary btn-sm"
                                    title="Abrir página pública permanente">
                                    Probar
                                  </a>

                                  <!-- Botón Reset si está asignada -->
                                  <% if (card.status==='assigned' ) { %>
                                    <form action="/admin/reset/<%= card.cardId %>" method="POST"
                                      onsubmit="return confirm('¿Deseas desvincular este negocio y dejar la tarjeta disponible?');"
                                      style="display:inline; margin: 0;">
                                      <button type="submit" class="btn-secondary btn-sm btn-danger-sm"
                                        title="Restablecer tarjeta a disponible">
                                        ✕
                                      </button>
                                    </form>
                                    <% } %>
                                </div>
                              </td>

                            </tr>
                            <% }); %>

                              <!-- Fila de estado cuando no hay resultados de búsqueda -->
                              <tr id="noSearchResultsRow" class="no-results-row" style="display: none;">
                                <td colspan="6">
                                  <div class="no-search-results">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                      stroke-width="1.75">
                                      <circle cx="11" cy="11" r="8"></circle>
                                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                      <line x1="8" y1="11" x2="14" y2="11"></line>
                                    </svg>
                                    <p class="no-search-results-title">No se encontraron tarjetas</p>
                                    <p class="no-search-results-desc">No hay coincidencias para "<strong
                                        id="noResultsQuery"></strong>"</p>
                                    <button type="button" class="btn-secondary btn-sm" onclick="clearCardSearch()"
                                      style="margin-top: 0.35rem;">
                                      Limpiar búsqueda
                                    </button>
                                  </div>
                                </td>
                              </tr>
                        </tbody>
                      </table>
                    </div>
                    <% } %>
              </section>

              <!-- Columna Derecha: Formulario de Asignación / Edición (Scroll Independiente) -->
              <section class="panel-box panel-form-box" style="box-sizing: border-box;">
                <div class="panel-header-row">
                  <h2 class="panel-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    <span>
                      <%= selectedCard ? `Configurar Tarjeta #${selectedCard.cardId}` : 'Asignar / Editar Tarjeta' %>
                    </span>
                  </h2>
                  <% if (selectedCard) { %>
                    <a href="/admin" class="btn-secondary btn-sm" style="font-size: 0.78rem;">
                      + Nueva Selección
                    </a>
                    <% } %>
                </div>

                <form id="card-form" action="/admin/update/<%= selectedCard ? selectedCard.cardId : '' %>" method="POST"
                  onsubmit="return validateForm(event)">
                  <!-- ==============================================
                       BLOQUE 1: IDENTIFICACIÓN Y PERFIL DEL NEGOCIO
                       ============================================== -->
                  <div class="form-module-card">
                    <div class="form-module-header">
                      <div class="form-module-title-group">
                        <div class="form-module-icon icon-general">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                          </svg>
                        </div>
                        <h3 class="form-module-title">Identificación y Perfil</h3>
                      </div>
                      <span class="form-module-badge badge-required">Requerido</span>
                    </div>

                    <!-- Selector / Input de Card ID -->
                    <div class="form-group" style="margin-bottom: 0.9rem;">
                      <label class="form-label" for="form-cardId">ID de la Tarjeta Física (cardId)</label>
                      <% if (selectedCard) { %>
                        <input type="text" id="form-cardId" class="form-input" value="<%= selectedCard.cardId %>"
                          readonly style="opacity: 0.8; cursor: not-allowed; background: var(--bg-deep);">
                        <% } else { %>
                          <input type="text" id="form-cardId" class="form-input" placeholder="Ej: 001" required
                            oninput="updateFormAction(this.value)">
                          <small class="form-hint">
                            Identificador grabado físicamente en la tarjeta NFC o QR.
                          </small>
                          <% } %>
                    </div>

                    <!-- Nombre del Negocio -->
                    <div class="form-group" style="margin-bottom: 0.9rem;">
                      <label class="form-label" for="businessName">
                        Nombre del Negocio Local <span id="businessNameRequiredMarker" style="color: #fca5a5;">*</span>
                      </label>
                      <input type="text" name="businessName" id="businessName" class="form-input"
                        placeholder="Ej: Café Quindío Gourmet"
                        value="<%= (selectedCard && selectedCard.businessName) ? selectedCard.businessName : '' %>">
                    </div>

                    <!-- Ubicación Personalizada del Local (Bajo el nombre) -->
                    <div class="form-group" style="margin-bottom: 0.9rem;">
                      <label class="form-label" for="location">
                        Ubicación Texto <span
                          style="font-size: 0.74rem; color: var(--text-muted); font-weight: 400;">(Bajo el
                          nombre)</span>
                      </label>
                      <input type="text" name="location" id="location" class="form-input"
                        placeholder="Ej: Guapotá, Santander o Calle 10 # 5-20"
                        value="<%= selectedCard ? (selectedCard.location || '') : '' %>">
                      <small class="form-hint">
                        Visible en la cabecera pública justo debajo del nombre.
                      </small>
                    </div>

                    <!-- Logo o Imagen de Perfil del Negocio -->
                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label">
                        Logo del Negocio <span
                          style="font-size: 0.74rem; color: var(--text-muted); font-weight: 400;">(Circular)</span>
                      </label>
                      <div class="logo-upload-container">
                        <div class="logo-preview-row">
                          <div class="logo-preview-avatar" id="logoPreviewContainer" title="Vista previa del logo"
                            style="width: 60px; height: 60px; min-width: 60px; min-height: 60px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                            <% const previewLogoSrc=(selectedCard && selectedCard.logoUrl) ?
                              ((selectedCard.logoUrl.startsWith('data:') || selectedCard.logoUrl.startsWith('http://')
                              || selectedCard.logoUrl.startsWith('https://') || selectedCard.logoUrl.startsWith('/')) ?
                              selectedCard.logoUrl : ('/' + selectedCard.logoUrl)) : '' ; %>
                              <% if (selectedCard && selectedCard.logoUrl) { %>
                                <img id="logoPreviewImg" src="<%= previewLogoSrc %>"
                                  alt="Logo <%= selectedCard.businessName || '' %>"
                                  style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%; display: block;">
                                <span id="logoPreviewFallback" style="display: none;">
                                  <%= (selectedCard.businessName && selectedCard.businessName.length> 0) ?
                                    selectedCard.businessName.charAt(0).toUpperCase() : 'N' %>
                                </span>
                                <% } else { %>
                                  <img id="logoPreviewImg" src="" alt="Previsualización"
                                    style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%; display: none;">
                                  <span id="logoPreviewFallback">
                                    <%= (selectedCard && selectedCard.businessName && selectedCard.businessName.length>
                                      0) ? selectedCard.businessName.charAt(0).toUpperCase() : 'N' %>
                                  </span>
                                  <% } %>
                          </div>
                          <div class="logo-upload-controls">
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                              <label for="logoFileInput" class="file-upload-btn-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                  stroke-width="2">
                                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                  <polyline points="17 8 12 3 7 8"></polyline>
                                  <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                                <span>Subir Imagen</span>
                              </label>

                              <input type="file" id="logoFileInput"
                                accept="image/png, image/jpeg, image/webp, image/svg+xml, image/gif"
                                style="display: none;" onchange="handleLogoFileSelect(this)">

                              <button type="button" id="removeLogoBtn" class="btn-secondary btn-sm"
                                style="<%= (selectedCard && selectedCard.logoUrl) ? '' : 'display: none;' %> font-size: 0.85rem; color: var(--btn-danger-text);"
                                onclick="handleRemoveLogo()" title="Eliminar logo actual">
                                ✕ Quitar
                              </button>
                            </div>
                          </div>
                          <!-- String Base64 generado en cliente para MongoDB -->
                          <input type="hidden" name="logoBase64" id="logoBase64" value="">
                          <input type="hidden" name="removeLogo" id="removeLogo" value="false">
                        </div>
                      </div>

                      <!-- Campo URL directa opcional -->
                      <% const isCustomExternalLogo=Boolean(selectedCard && selectedCard.logoUrl &&
                        !selectedCard.logoUrl.startsWith('data:') && !selectedCard.logoUrl.includes('uploads/')); %>
                        <div id="logoUrlWrapper"
                          style="<%= isCustomExternalLogo ? '' : 'display: none;' %> margin-top: 0.4rem;">
                          <input type="url" name="logoUrlCustom" id="logoUrlCustom" class="form-input"
                            placeholder="https://ejemplo.com/logo.png"
                            value="<%= isCustomExternalLogo ? selectedCard.logoUrl : '' %>"
                            oninput="handleLogoUrlInput(this.value)" style="font-size: 0.82rem; min-height: 38px;">
                          <small class="form-hint">Enlace https directo a una imagen JPG, PNG, WebP o SVG.</small>
                        </div>
                    </div>
                  </div>

                  <!-- ==============================================
                       BLOQUE 2: WHATSAPP PRINCIPAL
                       ============================================== -->
                  <div class="form-module-card">
                    <div class="form-module-header">
                      <div class="form-module-title-group">
                        <div class="form-module-icon icon-whatsapp">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5">
                            <path
                              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                          </svg>
                        </div>
                        <h3 class="form-module-title">WhatsApp Principal</h3>
                      </div>
                      <span class="form-module-badge">Contacto</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label" for="whatsappNumber">Número de WhatsApp</label>
                      <input type="text" name="whatsappNumber" id="whatsappNumber" class="form-input"
                        placeholder="Ej: 3001234567 o +57 300 123 4567"
                        value="<%= selectedCard ? selectedCard.whatsappNumber : '' %>">
                      <small class="form-hint">Línea directa para chat de atención inmediata.</small>
                    </div>

                    <!-- Personalización de Título y Subtítulo -->
                    <div class="form-custom-texts-box">
                      <div class="form-custom-texts-header">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2">
                          <path d="M12 20h9"></path>
                          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                        <span>Personalización del Botón</span>
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="whatsappTitle">Título del Botón</label>
                        <input type="text" name="whatsappTitle" id="whatsappTitle" class="form-custom-input"
                          placeholder="WhatsApp Principal"
                          value="<%= selectedCard ? (selectedCard.whatsappTitle || 'WhatsApp Principal') : 'WhatsApp Principal' %>">
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="whatsappSubtitle">Subtítulo del Botón</label>
                        <input type="text" name="whatsappSubtitle" id="whatsappSubtitle" class="form-custom-input"
                          placeholder="Atención inmediata por chat"
                          value="<%= selectedCard ? (selectedCard.whatsappSubtitle || 'Atención inmediata por chat') : 'Atención inmediata por chat' %>">
                      </div>
                    </div>
                  </div>

                  <!-- ==============================================
                       BLOQUE 3: SEGUNDO WHATSAPP
                       ============================================== -->
                  <div class="form-module-card">
                    <div class="form-module-header">
                      <div class="form-module-title-group">
                        <div class="form-module-icon icon-whatsapp">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5">
                            <path
                              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                          </svg>
                        </div>
                        <h3 class="form-module-title">Segundo WhatsApp</h3>
                      </div>
                      <span class="form-module-badge">Línea 2</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label" for="whatsappNumber2">Segundo Número de WhatsApp</label>
                      <input type="text" name="whatsappNumber2" id="whatsappNumber2" class="form-input"
                        placeholder="Ej: 3109876543 o +57 310 987 6543"
                        value="<%= selectedCard ? (selectedCard.whatsappNumber2 || '') : '' %>">
                      <small class="form-hint">Línea alterna para pedidos, domicilios o soporte.</small>
                    </div>

                    <!-- Personalización de Título y Subtítulo -->
                    <div class="form-custom-texts-box">
                      <div class="form-custom-texts-header">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2">
                          <path d="M12 20h9"></path>
                          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                        <span>Personalización del Botón</span>
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="whatsapp2Title">Título del Botón</label>
                        <input type="text" name="whatsapp2Title" id="whatsapp2Title" class="form-custom-input"
                          placeholder="Segundo WhatsApp"
                          value="<%= selectedCard ? (selectedCard.whatsapp2Title || 'Segundo WhatsApp') : 'Segundo WhatsApp' %>">
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="whatsapp2Subtitle">Subtítulo del Botón</label>
                        <input type="text" name="whatsapp2Subtitle" id="whatsapp2Subtitle" class="form-custom-input"
                          placeholder="Línea secundaria de atención"
                          value="<%= selectedCard ? (selectedCard.whatsapp2Subtitle || 'Línea secundaria de atención') : 'Línea secundaria de atención' %>">
                      </div>
                    </div>
                  </div>

                  <!-- ==============================================
                       BLOQUE: GUARDAR EN CONTACTOS (vCard / .vcf)
                       ============================================== -->
                  <div class="form-module-card">
                    <div class="form-module-header">
                      <div class="form-module-title-group">
                        <div class="form-module-icon icon-vcard">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <line x1="20" y1="8" x2="20" y2="14"></line>
                            <line x1="23" y1="11" x2="17" y2="11"></line>
                          </svg>
                        </div>
                        <h3 class="form-module-title">Guardar en Contactos (.vcf)</h3>
                      </div>
                      <span class="form-module-badge" style="color: #93c5fd; background: rgba(59, 130, 246, 0.15);">vCard</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label" for="contactPhone">Teléfono para Guardar en Contactos</label>
                      <input type="text" name="contactPhone" id="contactPhone" class="form-input"
                        placeholder="Ej: 3001234567 o +57 300 123 4567 (Opcional)"
                        value="<%= selectedCard ? (selectedCard.contactPhone || '') : '' %>">
                      <small class="form-hint">
                        Número exclusivo para la tarjeta de contacto .vcf descargable. Si se deja vacío, no se incluirá teléfono en el archivo ni se mostrará el botón en el perfil público.
                      </small>
                    </div>
                  </div>

                  <!-- ==============================================
                       BLOQUE 4: INSTAGRAM
                       ============================================== -->
                  <div class="form-module-card">
                    <div class="form-module-header">
                      <div class="form-module-title-group">
                        <div class="form-module-icon icon-instagram">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                          </svg>
                        </div>
                        <h3 class="form-module-title">Instagram</h3>
                      </div>
                      <span class="form-module-badge">Social</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label" for="instagramUrl">Perfil o Enlace de Instagram</label>
                      <input type="text" name="instagramUrl" id="instagramUrl" class="form-input"
                        placeholder="Ej: @cafequindio o https://instagram.com/cafequindio"
                        value="<%= selectedCard ? selectedCard.instagramUrl : '' %>">
                      <small class="form-hint">Usuario con @ o enlace completo a la cuenta.</small>
                    </div>

                    <!-- Personalización de Título y Subtítulo -->
                    <div class="form-custom-texts-box">
                      <div class="form-custom-texts-header">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2">
                          <path d="M12 20h9"></path>
                          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                        <span>Personalización del Botón</span>
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="instagramTitle">Título del Botón</label>
                        <input type="text" name="instagramTitle" id="instagramTitle" class="form-custom-input"
                          placeholder="Síguenos en Instagram"
                          value="<%= selectedCard ? (selectedCard.instagramTitle || 'Síguenos en Instagram') : 'Síguenos en Instagram' %>">
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="instagramSubtitle">Subtítulo del Botón</label>
                        <input type="text" name="instagramSubtitle" id="instagramSubtitle" class="form-custom-input"
                          placeholder="Novedades, fotos y catálogo"
                          value="<%= selectedCard ? (selectedCard.instagramSubtitle || 'Novedades, fotos y catálogo') : 'Novedades, fotos y catálogo' %>">
                      </div>
                    </div>
                  </div>

                  <!-- ==============================================
                       BLOQUE 5: FACEBOOK
                       ============================================== -->
                  <div class="form-module-card">
                    <div class="form-module-header">
                      <div class="form-module-title-group">
                        <div class="form-module-icon icon-facebook">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                          </svg>
                        </div>
                        <h3 class="form-module-title">Facebook</h3>
                      </div>
                      <span class="form-module-badge">Social</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label" for="facebookUrl">Enlace o Página de Facebook</label>
                      <input type="text" name="facebookUrl" id="facebookUrl" class="form-input"
                        placeholder="Ej: https://facebook.com/cafequindio o @cafequindio"
                        value="<%= selectedCard ? (selectedCard.facebookUrl || '') : '' %>">
                      <small class="form-hint">Enlace a la página comercial de Facebook.</small>
                    </div>

                    <!-- Personalización de Título y Subtítulo -->
                    <div class="form-custom-texts-box">
                      <div class="form-custom-texts-header">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2">
                          <path d="M12 20h9"></path>
                          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                        <span>Personalización del Botón</span>
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="facebookTitle">Título del Botón</label>
                        <input type="text" name="facebookTitle" id="facebookTitle" class="form-custom-input"
                          placeholder="Síguenos en Facebook"
                          value="<%= selectedCard ? (selectedCard.facebookTitle || 'Síguenos en Facebook') : 'Síguenos en Facebook' %>">
                      </div>
                      <div class="form-custom-field">
                        <label class="form-custom-label" for="facebookSubtitle">Subtítulo del Botón</label>
                        <input type="text" name="facebookSubtitle" id="facebookSubtitle" class="form-custom-input"
                          placeholder="Comunidad, noticias y eventos"
                          value="<%= selectedCard ? (selectedCard.facebookSubtitle || 'Comunidad, noticias y eventos') : 'Comunidad, noticias y eventos' %>">
                      </div>
                    </div>
                  </div>

                  <!-- ==============================================
                       BLOQUE 6: TIKTOK
                       ============================================== -->
                  <div class="form-module-card">
                    <div class="form-module-header">
                      <div class="form-module-title-group">
                        <div class="form-module-icon icon-tiktok">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path
                              d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.35 22a6.34 6.34 0 0 0 6.33-6.32V8.75a8.28 8.28 0 0 0 4.84 1.56V6.85a4.78 4.78 0 0 1-.93-.16z" />
                          </svg>
                        </div>
                        <h3 class="form-module-title">TikTok</h3>
                      </div>
                      <span class="form-module-badge">Video</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label" for="tiktokUrl">Perfil o Enlace de TikTok</label>
                      <input type="text" name="tiktokUrl" id="tiktokUrl" class="form-input"
                        placeholder="Ej: @cafequindio o https://tiktok.com/@cafequindio"
                        value="<%= selectedCard ? (selectedCard.tiktokUrl || '') : '' %>">
                      <small class="form-hint">Perfil de creador o empresa en TikTok.</small>
                    </div>

