<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title><%= card.businessName ? card.businessName : 'Tarjeta NFC' %> | Conexión Oficial</title>
  <meta name="description" content="Canales digitales oficiales y verificación para <%= card.businessName || 'este comercio' %>. Conéctate por WhatsApp, Instagram, Facebook y Ubicación en Google Maps.">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22%20%220%22%20%22100%22%20%22100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">
</head>
<body>
  <div class="mobile-viewport">
    <main class="mobile-card-container">
      
      <!-- Encabezado del Perfil Oficial -->
      <header class="profile-header">
        <div class="avatar-wrapper">
          <div class="business-avatar <%= (card.logoUrl && card.logoUrl.trim()) ? 'has-logo' : '' %>" aria-label="Logo del negocio">

            
            <% if (card.logoUrl && card.logoUrl.trim()) { 
                const pLogoSrc = (card.logoUrl.startsWith('data:') || card.logoUrl.startsWith('http://') || card.logoUrl.startsWith('https://') || card.logoUrl.startsWith('/'))
                  ? card.logoUrl.trim()
                  : ('/' + card.logoUrl.trim());
            %>
              <img src="<%= pLogoSrc %>" alt="Logo <%= card.businessName || 'Negocio' %>" class="avatar-logo-img" onerror="this.style.display='none'; document.getElementById('avatar-fallback-text').style.display='flex';">
              <span id="avatar-fallback-text" style="display: none;"><%= (card.businessName && card.businessName.length > 0) ? card.businessName.trim().charAt(0).toUpperCase() : 'N' %></span>
            <% } else { %>
              <%= (card.businessName && card.businessName.length > 0) ? card.businessName.trim().charAt(0).toUpperCase() : 'N' %>
            <% } %>
          </div>
          <div class="nfc-badge" title="Lectura NFC Certificada">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
              <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
            </svg>
          </div>
        </div>

        <h1 class="business-title"><%= card.businessName || 'Negocio Local' %></h1>
        
        <div class="business-tagline">
          <span class="pulse-dot"></span>
          <span><%= (card.location && card.location.trim()) ? card.location.trim() : 'Perfil Oficial Verificado &bull; Colombia' %></span>
        </div>
      </header>

      <!-- Botón Principal Destacado: Guardar en Contactos (vCard .vcf) - Solo visible si contactPhone está configurado -->
      <% if (card.contactPhone && card.contactPhone.trim() !== '') { %>
      <div class="save-contact-container">
        <a href="/p/<%= card.cardId %>/save-contact" class="btn-save-contact" id="btn-save-contact" download title="Guardar este negocio en la agenda de tu teléfono">
          <div class="btn-save-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4"></circle>
              <line x1="20" y1="8" x2="20" y2="14"></line>
              <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
          </div>
          <span class="btn-save-text">Guardar en Contactos</span>
          <div class="btn-save-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </div>
        </a>
      </div>
      <% } %>

      <% 
        // Verificaciones estrictas de existencia de canales (no nulos ni vacíos)
        const hasWhatsapp = Boolean(card.whatsappNumber && card.whatsappNumber.trim() !== '' && card.whatsappLink);
        const hasWhatsapp2 = Boolean(card.whatsappNumber2 && card.whatsappNumber2.trim() !== '' && card.whatsappLink2);
        const hasInstagram = Boolean(card.instagramUrl && card.instagramUrl.trim() !== '' && card.instagramLink);
        const hasFacebook = Boolean(card.facebookUrl && card.facebookUrl.trim() !== '' && card.facebookLink);
        const hasTiktok = Boolean(card.tiktokUrl && card.tiktokUrl.trim() !== '' && card.tiktokLink);
        const hasWebsite = Boolean(card.websiteUrl && card.websiteUrl.trim() !== '');
        const hasLocation = Boolean(card.googleReviewsUrl && card.googleReviewsUrl.trim() !== '');
        const hasAnyAction = hasWhatsapp || hasWhatsapp2 || hasInstagram || hasFacebook || hasTiktok || hasWebsite || hasLocation;
      %>

      <!-- Canales de Contacto Directo (Estrictamente Condicionales) -->
      <% if (hasAnyAction) { %>
        <section class="actions-list" aria-label="Canales oficiales de contacto">
          
          <!-- Canal WhatsApp Principal Señorial -->
          <% if (hasWhatsapp) { 
              const waTitle = (card.whatsappTitle && card.whatsappTitle.trim()) ? card.whatsappTitle.trim() : 'WhatsApp Principal';
              const waSubtitle = (card.whatsappSubtitle && card.whatsappSubtitle.trim()) ? card.whatsappSubtitle.trim() : 'Atención inmediata por chat';
          %>
            <a href="<%= card.whatsappLink %>" target="_blank" rel="noopener noreferrer" class="action-btn btn-whatsapp" id="btn-whatsapp">
              <div class="btn-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                </svg>
              </div>
              <div class="btn-text-group">
                <span class="btn-title"><%= waTitle %></span>
                <span class="btn-subtitle"><%= waSubtitle %></span>
              </div>
              <div class="btn-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          <% } %>

          <!-- Canal WhatsApp Secundario Señorial -->
          <% if (hasWhatsapp2) { 
              const wa2Title = (card.whatsapp2Title && card.whatsapp2Title.trim()) ? card.whatsapp2Title.trim() : 'Segundo WhatsApp';
              const wa2Subtitle = (card.whatsapp2Subtitle && card.whatsapp2Subtitle.trim()) ? card.whatsapp2Subtitle.trim() : 'Línea secundaria de atención';
          %>
            <a href="<%= card.whatsappLink2 %>" target="_blank" rel="noopener noreferrer" class="action-btn btn-whatsapp" id="btn-whatsapp-2">
              <div class="btn-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                </svg>
              </div>
              <div class="btn-text-group">
                <span class="btn-title"><%= wa2Title %></span>
                <span class="btn-subtitle"><%= wa2Subtitle %></span>
              </div>
              <div class="btn-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          <% } %>

          <!-- Canal Instagram Señorial -->
          <% if (hasInstagram) { 
              const igTitle = (card.instagramTitle && card.instagramTitle.trim()) ? card.instagramTitle.trim() : 'Síguenos en Instagram';
              const igSubtitle = (card.instagramSubtitle && card.instagramSubtitle.trim()) ? card.instagramSubtitle.trim() : 'Novedades, fotos y catálogo';
          %>
            <a href="<%= card.instagramLink %>" target="_blank" rel="noopener noreferrer" class="action-btn btn-instagram" id="btn-instagram">
              <div class="btn-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </div>
              <div class="btn-text-group">
                <span class="btn-title"><%= igTitle %></span>
                <span class="btn-subtitle"><%= igSubtitle %></span>
              </div>
              <div class="btn-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          <% } %>

          <!-- Canal Facebook Señorial -->
          <% if (hasFacebook) { 
              const fbTitle = (card.facebookTitle && card.facebookTitle.trim()) ? card.facebookTitle.trim() : 'Síguenos en Facebook';
              const fbSubtitle = (card.facebookSubtitle && card.facebookSubtitle.trim()) ? card.facebookSubtitle.trim() : 'Comunidad, noticias y eventos';
          %>
            <a href="<%= card.facebookLink %>" target="_blank" rel="noopener noreferrer" class="action-btn btn-facebook" id="btn-facebook">
              <div class="btn-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </div>
              <div class="btn-text-group">
                <span class="btn-title"><%= fbTitle %></span>
                <span class="btn-subtitle"><%= fbSubtitle %></span>
              </div>
              <div class="btn-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          <% } %>

          <!-- Canal TikTok Señorial -->
          <% if (hasTiktok) { 
              const ttTitle = (card.tiktokTitle && card.tiktokTitle.trim()) ? card.tiktokTitle.trim() : 'Síguenos en TikTok';
              const ttSubtitle = (card.tiktokSubtitle && card.tiktokSubtitle.trim()) ? card.tiktokSubtitle.trim() : 'Videos y contenido exclusivo';
          %>
            <a href="<%= card.tiktokLink %>" target="_blank" rel="noopener noreferrer" class="action-btn btn-tiktok" id="btn-tiktok">
              <div class="btn-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.35 22a6.34 6.34 0 0 0 6.33-6.32V8.75a8.28 8.28 0 0 0 4.84 1.56V6.85a4.78 4.78 0 0 1-.93-.16z"/>
                </svg>
              </div>
              <div class="btn-text-group">
                <span class="btn-title"><%= ttTitle %></span>
                <span class="btn-subtitle"><%= ttSubtitle %></span>
              </div>
              <div class="btn-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          <% } %>

          <!-- Canal Sitio Web Oficial Señorial -->
          <% if (hasWebsite) { 
              const websiteHref = card.websiteLink || (/^https?:\/\//i.test(card.websiteUrl.trim()) ? card.websiteUrl.trim() : ('https://' + card.websiteUrl.trim()));
              const customTitle = (card.websiteTitle && card.websiteTitle.trim()) ? card.websiteTitle.trim() : 'Visita Nuestro Sitio Web';
              const customSubtitle = (card.websiteSubtitle && card.websiteSubtitle.trim()) ? card.websiteSubtitle.trim() : 'Tienda virtual y catálogo oficial';
          %>
            <a href="<%= websiteHref %>" target="_blank" rel="noopener noreferrer" class="action-btn btn-website" id="btn-website">
              <div class="btn-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </div>
              <div class="btn-text-group">
                <span class="btn-title"><%= customTitle %></span>
                <span class="btn-subtitle"><%= customSubtitle %></span>
              </div>
              <div class="btn-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          <% } %>

          <!-- Canal Ubicación del Local (Google Maps) -->
          <% if (hasLocation) { 
              const locTitle = (card.googleReviewsTitle && card.googleReviewsTitle.trim()) ? card.googleReviewsTitle.trim() : 'Ubicación del Local';
              const locSubtitle = (card.googleReviewsSubtitle && card.googleReviewsSubtitle.trim()) ? card.googleReviewsSubtitle.trim() : 'Ver en Google Maps • Cómo llegar';
          %>
            <a href="<%= card.googleReviewsUrl %>" target="_blank" rel="noopener noreferrer" class="action-btn btn-location" id="btn-location">
              <div class="btn-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="btn-text-group">
                <span class="btn-title"><%= locTitle %></span>
                <span class="btn-subtitle"><%= locSubtitle %></span>
              </div>
              <div class="btn-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          <% } %>

        </section>
      <% } %>

      <!-- Botón de Compartir Perfil -->
      <div style="margin-bottom: 1.5rem; text-align: center;">
        <button id="btn-share" class="btn-secondary" style="width: 100%; justify-content: center; min-height: 46px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          <span id="share-text">Compartir Perfil</span>
        </button>
      </div>

      <!-- Pie de la Tarjeta Móvil -->
      <footer class="mobile-footer">
        <!-- Contador sutil y elegante de escaneos totales -->
        <div class="scan-counter-badge" title="Total de visitas y lecturas registradas">
          <svg class="scan-counter-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <span>Escaneos totales: <strong class="scan-count-number"><%= card.scanCount || 0 %></strong></span>
        </div>

        <!-- Footer Comercial Interactivo ("Powered by NithSoft") -->
        <% 
          const commercialMsg = encodeURIComponent("Hola Nithson, vi una tarjeta inteligente de NithSoft en un local y quiero una para mi negocio");
          const commercialPhone = "573209025487";
          const commercialWaUrl = `https://wa.me/${commercialPhone}?text=${commercialMsg}`;
        %>
        <a href="<%= commercialWaUrl %>" target="_blank" rel="noopener noreferrer" class="nfc-tag-indicator powered-by-link" title="Solicita una Tarjeta Inteligente para tu negocio">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
          <span>Powered by <strong>NithSoft</strong> &bull; Standee #<%= card.cardId %></span>
        </a>

        
      </footer>

    </main>
  </div>

  <script>
    // Compartir perfil con Web Share API o copiar URL
    const shareBtn = document.getElementById('btn-share');
    const shareText = document.getElementById('share-text');

    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: '<%= card.businessName %>',
              text: 'Conoce <%= card.businessName %> en sus canales digitales oficiales:',
              url: window.location.href
            });
          } catch (err) {
            // Cancelado por el usuario
          }
        } else {
          navigator.clipboard.writeText(window.location.href).then(() => {
            shareText.textContent = '¡Enlace copiado!';
            setTimeout(() => {
              shareText.textContent = 'Compartir Perfil';
            }, 2500);
          });
        }
      });
    }
  </script>
</body>
</html>
